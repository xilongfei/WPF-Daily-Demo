<Window
    Height="560"
    Title="MainWindow"
    Width="980"
    mc:Ignorable="d"
    x:Class="Pdf_Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Pdf_Test"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scott="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  TabItem 样式：默认使用主题的次级文字色，选中后切换到强调色与白色反色，图标也随之变色  -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            x:Name="Border">
                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Border" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Grid.Row="0"
            Padding="12,10">
            <DockPanel LastChildFill="False">
                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Margin="0,0,16,0"
                        Text="Theme Demo" />
                </StackPanel>

                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                        Theme:
                    </TextBlock>
                    <ComboBox
                        SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        Width="140">
                        <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                        <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                        <ComboBoxItem Tag="System">Follow System</ComboBoxItem>
                    </ComboBox>

                    <TextBlock
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="16,0,8,0"
                        VerticalAlignment="Center">
                        Accent:
                    </TextBlock>
                    <ComboBox
                        SelectedValue="{Binding SelectedAccent, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        Width="120">
                        <ComboBoxItem Tag="Blue">Blue</ComboBoxItem>
                        <ComboBoxItem Tag="Emerald">Emerald</ComboBoxItem>
                        <ComboBoxItem Tag="Rose">Rose</ComboBoxItem>
                        <ComboBoxItem Tag="Purple">Purple</ComboBoxItem>
                        <ComboBoxItem Tag="Amber">Amber</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Grid.Column="0"
                Margin="0,0,20,0"
                Padding="12">
                <scott:WpfPlot x:Name="WpfPlot" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Margin="0,0,0,12"
                    Text="Overview" />

                <!--  TabControl：每个页签都携带自定义 SVG 图标，图标颜色会跟随 TabItem 的前景色变化  -->
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem IsSelected="True">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!--  Summary 图标：折线趋势图，强调色与主题切换时会同步变换  -->
                                <Path
                                    Data="M2,16 L2,10 L6,10 L10,6 L14,12 L18,4 L22,4 L22,16"
                                    Fill="Transparent"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Width="14" />
                                <TextBlock
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    Text="Summary"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="12,16,0,0">
                            <TextBlock
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,0,0,8"
                                Text="Revenue trending" />
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="Up 18.4% compared to last month" />
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0">
                                Product health is stable, with a strong conversion lift and a more active retention curve.
                            </TextBlock>
                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <Button Content="Export" Margin="0,0,12,0" />
                                <Button Content="Share" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource IconFont1}"
                                    FontSize="99"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="&#xe65f;" />
                                <TextBlock
                                    FontFamily="{StaticResource IconFont1}"
                                    FontSize="99"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="&#xe65f;" />
                            </StackPanel>

                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!--  Details 图标：文件/列表线稿，适合信息展示页  -->
                                <Path
                                    Data="M6,2 L16,2 L22,8 L22,20 C22,21.1 21.1,22 20,22 L6,22 C4.9,22 4,21.1 4,20 L4,4 C4,2.9 4.9,2 6,2 Z M16,2 L16,8 L22,8 M8,12 H18 M8,15 H18 M8,18 H15"
                                    Fill="Transparent"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Width="14" />
                                <TextBlock
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    Text="Details"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="12,16,0,0">
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="Retention" />
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentBrush}"
                                Margin="0,8,0,0"
                                Text="82.5%" />
                            <TextBlock
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,12,0,0"
                                Text="Follow this link for more details">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}">View report</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <!--  Settings 图标：齿轮，象征偏好和系统配置，适合主题/强调色统一控制区  -->
                                <Path
                                    Data="M11,2.5 L12.5,5.4 L15.3,4.4 L16.7,7.1 L19.8,7.1 L19.4,10.3 L22,12 L19.4,13.7 L19.8,16.9 L16.7,16.9 L15.3,19.6 L12.5,18.6 L11,21.5 L9.5,18.6 L6.7,19.6 L5.3,16.9 L2.2,16.9 L2.6,13.7 L0,12 L2.6,10.3 L2.2,7.1 L5.3,7.1 L6.7,4.4 L9.5,5.4 Z M12,8.5 A3.5,3.5 0 1 1 12,15.5 A3.5,3.5 0 1 1 12,8.5 Z"
                                    Fill="Transparent"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Width="14" />
                                <TextBlock
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                    Text="Settings"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="12,16,0,0">
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Text="Workspace preference" />
                            <TextBlock
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,8,0,0"
                                Text="Theme and accent settings are synced globally" />
                            <Button Content="Apply preset" Margin="0,20,0,0" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
